#!/bin/sh
# volrec pre-push hook (OPS-AGENT.md item 4, 23 Sep 2026): a push to main cannot
# carry a FAILING pressure test. Warnings pass; only FAIL or a crash blocks.
#
# Installed per clone with:   git config core.hooksPath tools/hooks
# Bypass in an emergency:     git push --no-verify   (say why in the commit message)
#
# It tests the WORKING TREE, which is what you just committed in the normal flow.
PY=/Library/Frameworks/Python.framework/Versions/3.14/bin/python3
[ -x "$PY" ] || PY=python3
pushing_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && pushing_main=1
done
[ "$pushing_main" = 1 ] || exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
out=$("$PY" tools/pressure_test.py 2>&1); code=$?
echo "$out" | grep -E "^RESULT" || { echo "pre-push: the pressure test CRASHED - push blocked"; echo "$out" | tail -8; exit 1; }
if [ $code -ne 0 ]; then
  echo "$out" | grep -E "^  FAIL"
  echo "pre-push: push BLOCKED by a failing pressure test. Fix it, or --no-verify with a reason."
  exit 1
fi
exit 0
