__pycache__/
*.pyc
log.txt
.env
.DS_Store
data/prices.json
data/market_vol.json
data/fred_cache.json

# Licensed vendor data. Bloomberg exports live in ~/Documents/volrec-bloomberg,
# OUTSIDE this repository, and the tools refuse any path inside it. This is the
# last line of defence for the day one lands here anyway - which it did on
# 16 Sep 2026, when the whole folder was moved into the repo root and only
# pressure_test.py's spreadsheet check caught it before `git add -A`.
*.xlsx
*.xls
*.xlsm
*.csv.gz
volrec-bloomberg/

# The analysis venv. timesfm[torch] is ~3 GB and must never reach a public repo.
.venv/

# Raw FRED series cached by analysis/timesfm_vix_baseline.py. FRED redistributes
# Cboe indices under permission and requires citation: derived values may be
# published, the raw series may NOT be mirrored here. See tools/fred.py.
analysis/data/

# Strict subset of the full benchmark result; regenerable, and committing
# both invites them drifting apart.
analysis/out/baselines_only.csv

# Databento / OPRA reference data (tools/opra_reference.py) lives in
# ~/Documents/volrec-databento, OUTSIDE this repository, and the key in
# ~/.config/volrec. Same licence regime as Bloomberg: aggregates only.
volrec-databento/
*.dbn
*.dbn.zst
*.key

# Papers obtained through interlibrary loan are licensed for private study only
# (Title 17; Pepperdine ILL terms) and live in ~/Documents/volrec-papers, OUTSIDE
# this repository. On 23 Sep 2026 one landed in the repo root, uncommitted.
*.pdf
volrec-papers/
